local function ui(par, co)
    local sc = Instance.new("UIStroke")
    sc.Thickness = 0.4
    sc.Color = Color3.fromRGB(255, 255, 255)
    sc.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    sc.Parent = par
    if co then
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, co)
        c.Parent = par
        return sc, c 
	end 
		return sc 
end


